# Multi-Agent Resume ATS Analyzer Configuration

# LLM Provider: "Hugging Face" or "Ollama"
LLM_PROVIDER=Hugging Face

# --- Hugging Face Configuration (Free Serverless Cloud) ---
# Paste your free Hugging Face token from https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Recommended free models:
# Qwen/Qwen2.5-7B-Instruct (Recommended)
# meta-llama/Llama-3.2-3B-Instruct
# mistralai/Mistral-7B-Instruct-v0.3
# deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# microsoft/Phi-3.5-mini-instruct
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Ollama Configuration (Local) ---
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
